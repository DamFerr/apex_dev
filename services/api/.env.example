# Copy this file to ".env" (same folder) and fill it in. The ".env" file is git-ignored. NEVER share it or paste the key anywhere.
#
# ---------- The only thing you MUST set ----------
# Your Riot API key from https://developer.riotgames.com (a personal "development key" expires every 24 hours: paste the new one here
# and restart "pnpm api"; a registered production key does not expire).
RIOT_API_KEY=

# ---------- Safe to leave as they are ----------
# Where to look first when searching for a player. The search itself finds the right region by itself.
RIOT_PLATFORM=euw1
PORT=8787
# Starting limits (requests per second, per 2 minutes) PER REGION. These are the limits of a development key. Riot reports the key's
# real limits on every response and the service adopts them automatically, so a production key runs faster with no change here.
RATE_PER_SECOND=20
RATE_PER_2MIN=100

# ---------- Data collector (collects every region and every rank by default; all optional) ----------
# Speed: a development key allows 100 requests per 2 minutes per Riot cluster (Europe, Americas, Asia, SEA), which is the real ceiling,
# about 3 games per second across all four. The settings below only make sure that ceiling is fully used.
# COLLECT_SHARE=0.8                          # share of the rate limit the collector may use (0.1 to 0.95). The rest stays free for the app itself.
# COLLECT_CONCURRENCY=16                     # parallel workers
# COLLECT_PAGES=1                            # ladder pages read per rank (about 200 players each). More pages = more players to crawl.
# COLLECT_DISABLED=1                         # do not collect (the app still works with what is stored)
# COLLECT_ONLY_PLATFORMS=euw1,na1            # restrict to some regions
# COLLECT_ONLY_TIERS=EMERALD,DIAMOND         # restrict to some ranks
# COLLECT_TIMELINES=0.25                     # share of collected games that also get their timeline (skill order, starting items, build order). 0 = off, 1 = all. Each one costs an extra Riot request.
